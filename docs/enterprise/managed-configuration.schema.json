{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecad.dev/schemas/managed-configuration-v1.json",
  "additionalProperties": false,
  "properties": {
    "allow_diagnostic_uploads": {"type": "boolean"},
    "allow_document_geometry": {"type": "boolean"},
    "allow_images": {"type": "boolean"},
    "custom_ca_path": {"type": "string"},
    "custom_ca_sha256": {"pattern": "^([0-9a-fA-F]{64})?$", "type": "string"},
    "audit_live_max_events": {"maximum": 1000000, "minimum": 100, "type": "integer"},
    "audit_live_retention_days": {"maximum": 3650, "minimum": 1, "type": "integer"},
    "audit_collection_allowed_hosts": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "audit_collection_enabled": {"type": "boolean"},
    "audit_collection_receipt_public_key": {"type": "string"},
    "audit_collection_url": {"format": "uri", "type": "string"},
    "audit_report_signer_fingerprint": {"pattern": "^([0-9a-fA-F]{64})?$", "type": "string"},
    "allowed_models": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "allowed_provider_hosts": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "allowed_providers": {"items": {"enum": ["openai", "anthropic", "chatgpt"]}, "type": "array", "uniqueItems": true},
    "allowed_update_hosts": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "export_enabled": {"type": "boolean"},
    "external_plugins_enabled": {"type": "boolean"},
    "identity_mode": {"enum": ["local", "managed", "oidc", "saml"]},
    "local_only": {"type": "boolean"},
    "managed": {"const": true},
    "managed_roles": {"items": {"enum": ["organization_owner", "administrator", "cad_manager", "designer", "reviewer", "viewer"]}, "type": "array", "uniqueItems": true},
    "managed_subject": {"type": "string"},
    "organization_id": {"type": "string"},
    "oidc_allowed_algorithms": {"items": {"enum": ["RS256", "ES256"]}, "type": "array", "uniqueItems": true},
    "oidc_allowed_hosts": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "oidc_client_id": {"type": "string"},
    "oidc_issuer": {"format": "uri", "type": "string"},
    "oidc_role_claim": {"type": "string"},
    "oidc_role_mapping": {
      "additionalProperties": {"enum": ["organization_owner", "administrator", "cad_manager", "designer", "reviewer", "viewer"]},
      "type": "object"
    },
    "oidc_scopes": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "policy_bundle_allowed_hosts": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "policy_bundle_enabled": {"type": "boolean"},
    "policy_bundle_public_key": {"type": "string"},
    "policy_bundle_url": {"format": "uri", "type": "string"},
    "proxy_allowed_hosts": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "proxy_mode": {"enum": ["system", "direct", "explicit"]},
    "proxy_url": {"type": "string"},
    "schema": {"const": "vibecad-managed-policy-v1"},
    "scim_allowed_hosts": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "scim_base_url": {"format": "uri", "type": "string"},
    "scim_enabled": {"type": "boolean"},
    "scim_role_mapping": {
      "additionalProperties": {"enum": ["organization_owner", "administrator", "cad_manager", "designer", "reviewer", "viewer"]},
      "type": "object"
    },
    "saml_acs_url": {"format": "uri", "type": "string"},
    "saml_allowed_hosts": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "saml_idp_certificate": {"type": "string"},
    "saml_idp_entity_id": {"type": "string"},
    "saml_role_attribute": {"type": "string"},
    "saml_role_mapping": {
      "additionalProperties": {"enum": ["organization_owner", "administrator", "cad_manager", "designer", "reviewer", "viewer"]},
      "type": "object"
    },
    "saml_sp_entity_id": {"type": "string"},
    "saml_sso_url": {"format": "uri", "type": "string"},
    "telemetry_enabled": {"type": "boolean"},
    "update_channel": {"enum": ["stable", "prerelease", "nightly", "disabled"]},
    "version": {"const": 1}
  },
  "required": ["schema", "version"],
  "title": "VibeCAD managed configuration",
  "type": "object"
}
